package com.mycompany.parcial;

import java.util.ArrayList;
import java.util.List;
import java.util.ListIterator;

/**
 *
 * @author prestamo
 */
public class Parcial {

    public static void main(String[] args) {
        // Definición de materias fijas
        List<String> materiasFijas = new ArrayList<>();
        materiasFijas.add("Piloto Matematicas");
        materiasFijas.add("Sociales");
        materiasFijas.add("Programación Estructurada");
        materiasFijas.add("Piloto Programacion");

        // Mostrar materias fijas usando un bucle for
        System.out.println("--- MATERIAS FIJAS ---");
        for (int i = 0; i < materiasFijas.size(); i++) {
            System.out.println("- " + materiasFijas.get(i));
        }

        // Definición de materias probables / opcionales
        List<String> materiasProb = new ArrayList<>();
        materiasProb.add("Emprendimiento");
        materiasProb.add("Ingles");
        materiasProb.add("Piloto Catequesis");
        materiasProb.add("I.A.");
        
        // Mostrar también las materias Proveedor
        System.out.println("\n--- MATERIAS PROVEEDOR ---");
        for (int i = 0; i < materiasProb.size(); i++) {
            System.out.println("- " + materiasProb.get(i));
        }
        
        // Crear una nueva lista que contenga ambas
        List<String> todasLasMaterias = new ArrayList<>(materiasFijas);
        todasLasMaterias.addAll(materiasProb);

        // Imprimir la lista unida
        System.out.println("\n--- TODAS LAS MATERIAS ---");
        for (String materia : todasLasMaterias) {
            System.out.println("- " + materia);
        }
        
        ListIterator<String> recorrido = todasLasMaterias.listIterator();
        System.out.println("\nREVISION MATERIA POR MATERIA PARA ELIMINAR LAS QUE TENGAN PILOTO");
        
        while (recorrido.hasNext()){
            String revisar_materia = recorrido.next();
            
            if (revisar_materia.startsWith("Piloto")){
                recorrido.remove();
                System.out.println(revisar_materia + " fue eliminada");
            }
        } // <- Llave de cierre del while agregada

        // Imprimir la lista final depurada
        System.out.println("\n--- TODAS LAS MATERIAS FINALES ---");
        for (String materia : todasLasMaterias) {
            System.out.println("- " + materia);
        }
    } 
}      
